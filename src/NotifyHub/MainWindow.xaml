<Window x:Class="NotifyHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:NotifyHub.Converters"
        mc:Ignorable="d"
        Title="Notify Hub — Native Windows Notification Manager"
        Icon="pack://application:,,,/Assets/notifyhub.ico"
        Height="840" Width="1340"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StatusToColorConverter x:Key="StatusToColor" />
        <conv:PriorityToColorConverter x:Key="PriorityToColor" />
        <conv:ForwardingStatusToTextConverter x:Key="ForwardingStatusToText" />
        <conv:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroToVis" />
        <conv:SourceRowBackgroundConverter x:Key="SourceRowBg" />
        <conv:SourceAccentBrushConverter x:Key="SourceAccentBrush" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER BAR -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/notifyhub.png" Width="38" Height="38"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NOTIFY HUB" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Centralized Windows Notification Control Center" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Live Status Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="12" Padding="12,5"
                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding MonitoringStatusText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Button Content="⚙️ Open Windows Settings" Style="{DynamicResource OutlineButton}"
                            Command="{Binding OpenSettingsPermissionCommand}"
                            Visibility="{Binding IsPermissionNeeded, Converter={StaticResource BoolToVis}}"
                            Margin="10,0,0,0" Padding="8,4" Foreground="{DynamicResource WarningBrush}"
                            BorderBrush="{DynamicResource WarningBrush}" ToolTip="Open Windows Settings > Privacy &amp; security > Notifications to grant access" />
                </StackPanel>

                <!-- Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Sync Now" Style="{DynamicResource OutlineButton}"
                            Command="{Binding TriggerManualSyncCommand}" Margin="0,0,8,0" ToolTip="Query latest notifications from Windows" />
                    
                    <Button Command="{Binding TogglePauseMonitoringCommand}" Margin="0,0,8,0"
                            x:Name="BtnPauseToggle">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Setter Property="Content" Value="Pause Monitoring" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Content" Value="Resume Monitoring" />
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Refresh" Style="{DynamicResource OutlineButton}"
                            Command="{Binding RefreshCommand}" Margin="0,0,8,0" />

                    <Button x:Name="BtnAnalyticsToggle" Content="📊 Analytics" Style="{DynamicResource OutlineButton}"
                            Click="BtnAnalyticsToggle_Click" Margin="0,0,8,0" ToolTip="Open Advanced Analytics &amp; Charts Dashboard" />

                    <Button x:Name="BtnSettingsToggle" Content="⚙️ Settings" Style="{DynamicResource ModernButton}" Click="BtnSettingsToggle_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. KPI METRIC CARDS -->
        <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource KpiCardStyle}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="TOTAL CAPTURED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding KpiSummary.TotalCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="Saved in SQLite" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="📊" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.4" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{DynamicResource KpiCardStyle}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="PENDING ACTION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding KpiSummary.PendingCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="Requires review" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="⏳" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.4" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{DynamicResource KpiCardStyle}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="IN PROGRESS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding KpiSummary.InProgressCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="Currently tracking" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="⚡" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.4" />
                    </Grid>
                </Border>

                <Border Grid.Column="3" Style="{DynamicResource KpiCardStyle}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="COMPLETED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding KpiSummary.CompletedCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="Marked done" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="✅" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.4" />
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{DynamicResource KpiCardStyle}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="RECEIVED TODAY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding KpiSummary.ReceivedTodayCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="Today's stream" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="📅" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.4" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 3. MAIN WORKSPACE / NOTIFICATIONS TABLE VIEW -->
        <Grid Grid.Row="2" x:Name="GridDashboardView" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Table & Filtering Column -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter & Search Toolbar -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{DynamicResource ModernTextBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,10,0" ToolTip="Global search by title, body, source app, or notes" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="App:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <ComboBox Width="120" ItemsSource="{Binding AppFilterList}" SelectedItem="{Binding SelectedApp}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Cat:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <ComboBox Width="130" ItemsSource="{Binding CategoryFilterList}" SelectedItem="{Binding SelectedCategory}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <ComboBox Width="105" ItemsSource="{Binding StatusFilterList}" SelectedItem="{Binding SelectedStatus}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Priority:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <ComboBox Width="90" ItemsSource="{Binding PriorityFilterList}" SelectedItem="{Binding SelectedPriority}" />
                            </StackPanel>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <ComboBox Width="100" ItemsSource="{Binding DateFilterList}" SelectedItem="{Binding SelectedDateFilter}" />
                            </StackPanel>

                            <StackPanel Grid.Column="7" Orientation="Horizontal">
                                <Button Content="📥 CSV" Style="{DynamicResource OutlineButton}" Command="{Binding ExportCsvCommand}" Margin="0,0,6,0" Padding="8,4" />
                                <Button Content="📊 Excel" Style="{DynamicResource OutlineButton}" Command="{Binding ExportExcelCommand}" Padding="8,4" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Bulk Actions Toolbar -->
                    <Border Grid.Row="1" Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1" Padding="14,8"
                            Visibility="{Binding SelectedCount, Converter={StaticResource GreaterThanZeroToVis}}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedCount, StringFormat='Selected: {0} item(s)'}" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Content="✓ Mark Done" Style="{DynamicResource OutlineButton}" Command="{Binding BulkMarkDoneCommand}" Margin="0,0,8,0" Padding="10,4" />
                                <Button Content="📁 Archive" Style="{DynamicResource OutlineButton}" Command="{Binding BulkArchiveCommand}" Margin="0,0,8,0" Padding="10,4" />
                                <Button Content="🗑️ Delete" Style="{DynamicResource OutlineButton}" Command="{Binding BulkDeleteCommand}" Margin="0,0,14,0" Padding="10,4" Foreground="{DynamicResource DangerBrush}" />
                                <Button Content="Deselect All" Style="{DynamicResource OutlineButton}" Command="{Binding DeselectAllCommand}" Padding="8,4" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Notifications DataGrid (Unique color tint per source app; changes color when Done) -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Notifications}"
                              SelectedItem="{Binding SelectedNotification, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                              SelectionMode="Single" SelectionUnit="FullRow">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridRow_PreviewMouseLeftButtonDown" />
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource SourceRowBg}">
                                            <Binding Path="AppName" />
                                            <Binding Path="Status" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu Background="{DynamicResource SidebarBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                            <MenuItem Header="🚀 Open Source Application"
                                                      Command="{Binding DataContext.OpenSourceAppCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="📋 Copy Title &amp; Message"
                                                      Command="{Binding DataContext.CopyNotificationFullCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="📋 Copy Message Body"
                                                      Command="{Binding DataContext.CopyNotificationBodyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="✓ Mark as Done"
                                                      Command="{Binding DataContext.MarkAsDoneCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="⚡ Mark as In Progress"
                                                      Command="{Binding DataContext.MarkAsInProgressCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="📁 Archive"
                                                      Command="{Binding DataContext.MarkAsArchivedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="🚫 Stop Recording This Source"
                                                      Command="{Binding DataContext.MuteSourceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="🗑️ Delete"
                                                      Command="{Binding DataContext.DeleteNotificationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Opacity" Value="0.68" />
                                    </DataTrigger>
                                    <!-- Selected row: keep source color, show a soft accent outline instead of solid blue -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        <Setter Property="BorderThickness" Value="0,1,0,1" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <!-- Remove default Windows blue cell highlight and dashed focus box -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Selection Checkbox -->
                            <DataGridTemplateColumn Width="38">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Record Key (N-1, N-2, ...) -->
                            <DataGridTemplateColumn Header="ID" Width="70" SortMemberPath="Id">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding DisplayId, Mode=OneWay}"
                                                 FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Padding="4,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Source App with matching source accent badge -->
                            <DataGridTemplateColumn Header="Source" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding AppName, Converter={StaticResource SourceAccentBrush}, ConverterParameter=75}"
                                                BorderBrush="{Binding AppName, Converter={StaticResource SourceAccentBrush}, ConverterParameter=165}"
                                                BorderThickness="1" CornerRadius="12" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding AppName, Mode=OneWay}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Category -->
                            <DataGridTemplateColumn Header="Category" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding Category, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                 Padding="6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Notification Title -->
                            <DataGridTemplateColumn Header="Title / Sender" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="12.5"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" Padding="6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Notification Content -->
                            <DataGridTemplateColumn Header="Message Content" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding Body, Mode=OneWay}" FontSize="12"
                                                 Foreground="{DynamicResource TextSecondaryBrush}" Padding="6,6" MaxHeight="38" TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Received Time -->
                            <DataGridTemplateColumn Header="Received" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding FormattedReceivedAt, Mode=OneWay}" FontSize="11.5"
                                                 Foreground="{DynamicResource TextMutedBrush}" Padding="6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Pending Duration -->
                            <DataGridTemplateColumn Header="Pending" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding PendingDurationText, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"
                                                 Foreground="{DynamicResource WarningBrush}" Padding="6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Priority Badge -->
                            <DataGridTemplateColumn Header="Priority" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding Priority, Mode=OneWay}" FontSize="11.5" FontWeight="Bold"
                                                 Foreground="{Binding Priority, Converter={StaticResource PriorityToColor}}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="Status" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                BorderBrush="{Binding Status, Converter={StaticResource StatusToColor}}" BorderThickness="1">
                                            <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding Status, Mode=OneWay}" FontSize="11" FontWeight="Bold"
                                                     Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Quick Actions (Open & Done) -->
                            <DataGridTemplateColumn Header="Actions" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="🚀 Open" Style="{DynamicResource OutlineButton}" Padding="6,2" FontSize="11"
                                                    Command="{Binding DataContext.OpenSourceAppCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="Open this notification (same as clicking Windows notification toast)" Margin="0,0,4,0" />
                                            <Button Content="✓ Done" Style="{DynamicResource OutlineButton}" Padding="6,2" FontSize="11"
                                                    Command="{Binding DataContext.MarkAsDoneCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="Mark Done" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right Inspection & Details Panel -->
            <Border Grid.Column="1" Width="370" Margin="14,0,0,0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10"
                    Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="NOTIFICATION DETAILS" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                            <Button Content="✕" Style="{DynamicResource OutlineButton}" Padding="6,2"
                                    Command="{Binding CloseDetailsCommand}" HorizontalAlignment="Right" />
                        </Grid>

                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding SelectedNotification.DisplayId, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,2" />
                                <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding SelectedNotification.AppName, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding SelectedNotification.Category, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,4" TextWrapping="Wrap" />
                                <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding SelectedNotification.FormattedReceivedAt, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>

                        <Button Content="🚀 Open Source Application" Style="{DynamicResource ModernButton}"
                                Command="{Binding OpenSourceAppCommand}"
                                CommandParameter="{Binding SelectedNotification}"
                                Margin="0,0,0,14" HorizontalAlignment="Stretch"
                                ToolTip="Open this notification in its source app (same as clicking Windows notification toast)" />

                        <TextBlock Text="TITLE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding SelectedNotification.Title}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Text="MESSAGE CONTENT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding SelectedNotification.Body}" IsReadOnly="True" TextWrapping="Wrap" Height="140" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="UPDATE STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Done" Style="{DynamicResource OutlineButton}" Padding="10,4" Margin="0,0,4,0"
                                            Command="{Binding MarkAsDoneCommand}" CommandParameter="{Binding SelectedNotification}" />
                                    <Button Content="Track" Style="{DynamicResource OutlineButton}" Padding="10,4"
                                            Command="{Binding MarkAsInProgressCommand}" CommandParameter="{Binding SelectedNotification}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="ARCHIVE / REMOVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Archive" Style="{DynamicResource OutlineButton}" Padding="10,4" Margin="0,0,4,0"
                                            Command="{Binding MarkAsArchivedCommand}" CommandParameter="{Binding SelectedNotification}" />
                                    <Button Content="Delete" Style="{DynamicResource OutlineButton}" Padding="10,4" Foreground="{DynamicResource DangerBrush}"
                                            Command="{Binding DeleteNotificationCommand}" CommandParameter="{Binding SelectedNotification}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="PERSONAL NOTES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding EditingNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6" />
                        <Button Content="Save Notes" Style="{DynamicResource ModernButton}" Command="{Binding SaveNotesCommand}" HorizontalAlignment="Right" Margin="0,0,0,16" />

                        <TextBlock Text="FORWARDING HISTORY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding NotificationForwardingLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                        <Grid>
                                            <StackPanel>
                                                <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding DestinationName, Mode=OneWay, StringFormat='Destination: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding FormattedTimestamp, Mode=OneWay, StringFormat='At: {0}'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding ErrorDetails, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                         Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                                            </StackPanel>
                                            <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding Status, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="Bold" FontSize="11"
                                                     Foreground="{DynamicResource SuccessBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. ADVANCED ANALYTICS & CHARTS DASHBOARD -->
        <Border Grid.Row="2" x:Name="BorderAnalyticsView" Background="{DynamicResource WindowBackgroundBrush}"
                Visibility="Collapsed" Margin="16,0,16,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <!-- CHART 1: Notifications by Source Application (Horizontal Bar Chart) -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="22" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="NOTIFICATIONS BY SOURCE APPLICATION" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="Each source uses its unique row color signature and shows Done vs. Pending counts." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SourceChartItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                                                 Fill="{Binding AppName, Converter={StaticResource SourceAccentBrush}, ConverterParameter=255}" />
                                                        <TextBlock Text="{Binding AppName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SummaryText}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="5" Height="12" HorizontalAlignment="Stretch">
                                                    <Border HorizontalAlignment="Left" CornerRadius="5" Height="12"
                                                            Width="{Binding BarWidth}"
                                                            Background="{Binding AppName, Converter={StaticResource SourceAccentBrush}, ConverterParameter=225}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- CHART 2: Activity Timeline (Last 7 / 30 Days Column Chart) -->
                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="22" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding TimelineTitle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                                <TextBlock Text="Daily notification volume captured over time." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="Last 7 Days" Style="{DynamicResource OutlineButton}" Command="{Binding SetTimeline7DaysCommand}" Padding="10,4" Margin="0,0,6,0" />
                                <Button Content="Last 30 Days" Style="{DynamicResource OutlineButton}" Command="{Binding SetTimeline30DaysCommand}" Padding="10,4" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding TimelineChartItems}" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="44" Margin="4,0" VerticalAlignment="Bottom" ToolTip="{Binding FullDateText}">
                                                <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                <Border Height="{Binding BarHeight}" Width="24" CornerRadius="5,5,0,0"
                                                        Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                                                <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 5. DEDICATED SETTINGS OVERLAY DASHBOARD -->
        <Border Grid.Row="2" x:Name="BorderSettingsView" Background="{DynamicResource WindowBackgroundBrush}"
                Visibility="Collapsed" Margin="16,0,16,16">
            <Border Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Settings Tabs Sidebar -->
                    <Border Grid.Column="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="14,16">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,14" />

                            <RadioButton Content="⚙️ General" Style="{x:Null}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         IsChecked="True" Margin="0,0,0,10" x:Name="TabGeneral" Checked="SettingsTab_Checked" />
                            <RadioButton Content="📡 Monitoring &amp; Apps" Style="{x:Null}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,0,0,10" x:Name="TabMonitoring" Checked="SettingsTab_Checked" />
                            <RadioButton Content="🏷️ Categories &amp; Rules" Style="{x:Null}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,0,0,10" x:Name="TabCategories" Checked="SettingsTab_Checked" />
                            <RadioButton Content="✈️ Telegram Forwarding" Style="{x:Null}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,0,0,10" x:Name="TabTelegram" Checked="SettingsTab_Checked" />
                            <RadioButton Content="📧 Email Forwarding" Style="{x:Null}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,0,0,10" x:Name="TabEmail" Checked="SettingsTab_Checked" />
                            <RadioButton Content="💾 Data &amp; Backup" Style="{x:Null}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,0,0,10" x:Name="TabData" Checked="SettingsTab_Checked" />
                            <RadioButton Content="📋 Delivery Logs" Style="{x:Null}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,0,0,14" x:Name="TabLogs" Checked="SettingsTab_Checked" />

                            <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,10,0,14" />
                            <Button Content="← Back to Dashboard" Style="{DynamicResource OutlineButton}" Click="BtnCloseSettings_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Settings Content Panels -->
                    <Border Grid.Column="1" Padding="24" Background="{DynamicResource CardBackgroundBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PanelSettingsContent">
                                <Grid Margin="0,0,0,20">
                                    <TextBlock x:Name="TxtSettingsTitle" Text="General Settings" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Button Content="Save All Settings" Style="{DynamicResource ModernButton}" Command="{Binding SettingsVm.SaveSettingsCommand}" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Subpanel: GENERAL -->
                                <StackPanel x:Name="SubpanelGeneral">
                                    <CheckBox Content="Launch Notify Hub automatically when Windows starts" IsChecked="{Binding SettingsVm.LaunchOnStartup}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,14" />
                                    <CheckBox Content="Hide application to System Tray when pressing Close (X) instead of exiting" IsChecked="{Binding SettingsVm.MinimizeToTray}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,14" />
                                    
                                    <TextBlock Text="Theme Selection:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                    <ComboBox Width="200" HorizontalAlignment="Left" Margin="0,0,0,16"
                                              ItemsSource="{Binding SettingsVm.ThemeOptions}"
                                              SelectedItem="{Binding SettingsVm.Theme, Mode=TwoWay}" />

                                    <TextBlock Text="Notification History Retention:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="Set to 0 to keep notification history forever." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                    <TextBox Width="120" HorizontalAlignment="Left" Style="{DynamicResource ModernTextBox}" Text="{Binding SettingsVm.RetentionDays}" Margin="0,0,0,20" />
                                </StackPanel>

                                <!-- Subpanel: MONITORING -->
                                <StackPanel x:Name="SubpanelMonitoring" Visibility="Collapsed">
                                    <CheckBox Content="Enable Notification Monitoring Service" IsChecked="{Binding SettingsVm.MonitoringEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,16" />

                                    <TextBlock Text="RECORDED SOURCES — CHECK TO RECORD, UNCHECK TO STOP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="Unchecking a source immediately stops recording new notifications from it (past history is kept). Re-check anytime to resume recording."
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                    <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SettingsVm.RecordedSources}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="6,6">
                                                            <Grid>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <CheckBox IsChecked="{Binding IsRecording, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                    <Ellipse Width="9" Height="9" Margin="0,0,8,0"
                                                                             Fill="{Binding AppName, Converter={StaticResource SourceAccentBrush}, ConverterParameter=255}" />
                                                                    <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding AppName, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11.5" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding SettingsVm.SourceToggleStatus, Mode=OneWay}"
                                             FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />

                                    <TextBlock Text="MANUALLY EXCLUDE A SOURCE BEFORE IT SENDS NOTIFICATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding SettingsVm.NewExcludedApp, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter an app name to exclude (e.g. Spotify)" />
                                        <Button Grid.Column="1" Content="Stop Recording App" Style="{DynamicResource OutlineButton}" Command="{Binding SettingsVm.AddExcludedAppCommand}" Margin="8,0,0,0" />
                                    </Grid>

                                    <TextBlock Text="MONITORING DIAGNOSTICS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                    <TextBox Style="{DynamicResource ModernTextBox}" Height="110" IsReadOnly="True" Text="{Binding SettingsVm.MonitoringDiagnostics, Mode=OneWay}" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />
                                </StackPanel>

                                <!-- Subpanel: CATEGORIES & RULES -->
                                <StackPanel x:Name="SubpanelCategories" Visibility="Collapsed">
                                    <TextBlock Text="CATEGORIES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                                    <DataGrid ItemsSource="{Binding SettingsVm.Categories}" AutoGenerateColumns="False" CanUserAddRows="False" Height="170"
                                              Background="{DynamicResource SidebarBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource CardBorderBrush}" GridLinesVisibility="Horizontal" Margin="0,0,0,16">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Icon" Binding="{Binding IconGlyph}" Width="45" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                            <DataGridTextColumn Header="Count" Binding="{Binding NotificationCount}" Width="60" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="SMART CATEGORIZATION RULES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                                    <DataGrid ItemsSource="{Binding SettingsVm.Rules}" AutoGenerateColumns="False" CanUserAddRows="False" Height="170"
                                              Background="{DynamicResource SidebarBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource CardBorderBrush}" GridLinesVisibility="Horizontal" Margin="0,0,0,16">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="160" />
                                            <DataGridTextColumn Header="Match Type" Binding="{Binding MatchType}" Width="140" />
                                            <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" Width="*" />
                                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>

                                <!-- Subpanel: TELEGRAM -->
                                <StackPanel x:Name="SubpanelTelegram" Visibility="Collapsed">
                                    <CheckBox Content="Enable Instant Telegram Forwarding" IsChecked="{Binding SettingsVm.TelegramEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,14" />
                                    
                                    <TextBlock Text="Telegram Bot Token:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="Stored securely using Windows Credential Manager." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                    <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding SettingsVm.TelegramBotToken, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                                    <TextBlock Text="Destination Chat ID:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="Can be a private user ID or a Telegram group ID (e.g. -100123456789)." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                    <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding SettingsVm.TelegramChatId, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left" Margin="0,0,0,16" />

                                    <Grid Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="Custom Telegram Message Template:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Available placeholders: {Id}, {AppName}, {Category}, {Title}, {Body}, {Time}, {Status}, {Priority}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Content="Reset to Default Template" Style="{DynamicResource OutlineButton}"
                                                Command="{Binding SettingsVm.ResetTelegramTemplateCommand}"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="8,3" FontSize="11" />
                                    </Grid>
                                    <TextBox Style="{DynamicResource ModernTextBox}"
                                             Text="{Binding SettingsVm.TelegramMessageTemplate, UpdateSourceTrigger=PropertyChanged}"
                                             Height="145" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,18" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Content="Test Connection (getMe)" Style="{DynamicResource OutlineButton}" Command="{Binding SettingsVm.TestTelegramConnectionCommand}" Margin="0,0,10,0" />
                                        <Button Content="Send Test Notification" Style="{DynamicResource ModernButton}" Command="{Binding SettingsVm.SendTestTelegramMessageCommand}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding SettingsVm.TelegramTestStatus}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                </StackPanel>

                                <!-- Subpanel: EMAIL -->
                                <StackPanel x:Name="SubpanelEmail" Visibility="Collapsed">
                                    <CheckBox Content="Enable Instant Email Forwarding" IsChecked="{Binding SettingsVm.EmailEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,14" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="SMTP Host:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding SettingsVm.SmtpHost, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Port:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding SettingsVm.SmtpPort, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Content="Use SSL / TLS Encryption" IsChecked="{Binding SettingsVm.SmtpUseSsl}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="SMTP Username:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding SettingsVm.SmtpUsername, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="SMTP Password:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding SettingsVm.SmtpPassword, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="From Address:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding SettingsVm.SmtpFromEmail, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Destination Email Address:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding SettingsVm.SmtpToEmail, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Content="Send Test Email" Style="{DynamicResource ModernButton}" Command="{Binding SettingsVm.SendTestEmailCommand}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding SettingsVm.EmailTestStatus}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                </StackPanel>

                                <!-- Subpanel: DATA & GOOGLE DRIVE BACKUP -->
                                <StackPanel x:Name="SubpanelData" Visibility="Collapsed">
                                    <TextBlock Text="LOCAL SQLITE DATABASE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                    <TextBox Style="{DynamicResource ModernTextBox}" IsReadOnly="True" Text="{Binding SettingsVm.DatabasePath, Mode=OneWay}" Margin="0,0,0,16" />

                                    <TextBlock Text="LOCAL BACKUP &amp; RESTORATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="Backup Database" Style="{DynamicResource OutlineButton}" Command="{Binding SettingsVm.BackupDatabaseCommand}" Margin="0,0,10,0" />
                                        <Button Content="Restore Database" Style="{DynamicResource OutlineButton}" Command="{Binding SettingsVm.RestoreDatabaseCommand}" Margin="0,0,10,0" />
                                        <Button Content="Clear All History" Style="{DynamicResource OutlineButton}" Command="{Binding SettingsVm.ClearHistoryCommand}" Foreground="{DynamicResource DangerBrush}" />
                                    </StackPanel>
                                    <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding SettingsVm.DbStatusMessage, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,18" TextWrapping="Wrap" />

                                    <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,4,0,18" />

                                    <!-- Google Drive Cloud Backup -->
                                    <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="☁️ GOOGLE DRIVE AUTOMATED BACKUP" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                                                    <TextBlock Text="Uses OAuth 2.0 + PKCE with minimal 'drive.file' scope (only accesses NotifyHub's own backup folder). Tokens are encrypted in Windows Credential Manager."
                                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding SettingsVm.GoogleDriveConnectionText, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding SettingsVm.LastGoogleDriveBackupText, Mode=OneWay, StringFormat='Last Cloud Backup: {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="🔗 Connect Google Drive" Style="{DynamicResource ModernButton}" Command="{Binding SettingsVm.ConnectGoogleDriveCommand}" Margin="0,0,8,0" Padding="10,6" />
                                                        <Button Content="☁️ Back Up Now" Style="{DynamicResource OutlineButton}" Command="{Binding SettingsVm.BackupToGoogleDriveNowCommand}" Margin="0,0,8,0" Padding="10,6" />
                                                        <Button Content="Disconnect" Style="{DynamicResource OutlineButton}" Command="{Binding SettingsVm.DisconnectGoogleDriveCommand}" Foreground="{DynamicResource DangerBrush}" Padding="10,6" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="Google OAuth Desktop Client ID:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                                    <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding SettingsVm.GoogleDriveClientId, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Google OAuth Client Secret (if provided):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                                    <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding SettingsVm.GoogleDriveClientSecret, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox Content="Enable Automatic Scheduled Backups to Google Drive"
                                                      IsChecked="{Binding SettingsVm.GoogleDriveBackupEnabled}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,4,0,12" />

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="Backup every:" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                <TextBox Style="{DynamicResource ModernTextBox}" Width="75" Text="{Binding SettingsVm.GoogleDriveBackupIntervalValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                                <ComboBox Width="110" ItemsSource="{Binding SettingsVm.BackupIntervalUnits}" SelectedItem="{Binding SettingsVm.GoogleDriveBackupIntervalUnit, Mode=TwoWay}" Margin="0,0,22,0" />

                                                <TextBlock Text="Keep latest:" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                <TextBox Style="{DynamicResource ModernTextBox}" Width="65" Text="{Binding SettingsVm.GoogleDriveMaxBackupsToKeep, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="files" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                                <TextBlock Text="Max Drive Space:" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                <TextBox Style="{DynamicResource ModernTextBox}" Width="75" Text="{Binding SettingsVm.GoogleDriveMaxSpaceValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                                <ComboBox Width="80" ItemsSource="{Binding SettingsVm.StorageSpaceUnits}" SelectedItem="{Binding SettingsVm.GoogleDriveMaxSpaceUnit, Mode=TwoWay}" Margin="0,0,10,0" />
                                                <TextBlock Text="(0 = unlimited; oldest backups automatically rotate out when limit is reached)" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>

                                            <TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding SettingsVm.GoogleDriveStatusMessage, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Subpanel: LOGS -->
                                <StackPanel x:Name="SubpanelLogs" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="FORWARDING DELIVERY LOGS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Retry Failed" Style="{DynamicResource ModernButton}" Command="{Binding SettingsVm.RetryFailedDeliveriesCommand}" Margin="0,0,8,0" Padding="8,4" />
                                            <Button Content="Refresh" Style="{DynamicResource OutlineButton}" Command="{Binding SettingsVm.RefreshLogsCommand}" Padding="8,4" />
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding SettingsVm.ForwardingLogs}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="380"
                                              Background="{DynamicResource SidebarBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource CardBorderBrush}" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Timestamp" Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding FormattedTimestamp, Mode=OneWay}" Padding="4,2" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Destination" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding DestinationName, Mode=OneWay}" Padding="4,2" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="App" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding AppName, Mode=OneWay}" Padding="4,2" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Title" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding NotificationTitle, Mode=OneWay}" Padding="4,2" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Status" Width="85">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding Status, Mode=OneWay}" Padding="4,2" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Attempts" Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding AttemptCount, Mode=OneWay}" Padding="4,2" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Error Details" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><TextBox Style="{DynamicResource SelectableTextStyle}" Text="{Binding ErrorDetails, Mode=OneWay}" Padding="4,2" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
